{
  "name": "iftb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "fetch:data": "tsx scripts/update-data.ts",
    "sample:data": "tsx scripts/update-data.ts --sample",
    "validate:data": "tsx scripts/validate-data.ts public/data/latest.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
